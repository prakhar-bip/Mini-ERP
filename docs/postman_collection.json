{
  "info": {
    "name": "Mini Operations ERP API Collection",
    "description": "Comprehensive Postman API Collection for Mini Operations ERP covering Auth, Inventory, Work Orders with Shortage Calculation, Multi-State Transfers, and Concurrency-Safe Order Reservations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Admin (Auto Sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('token', json.data.token);",
                  "        console.log('Token set successfully for Admin');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login - Operations (Auto Sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('token', json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ops@erp.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login - Sales (Auto Sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('token', json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@erp.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Master Data",
      "item": [
        {
          "name": "Get All Warehouses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/master/locations"
          }
        },
        {
          "name": "Get All Items Catalog",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/master/items"
          }
        },
        {
          "name": "Get Assignable Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/master/users"
          }
        }
      ]
    },
    {
      "name": "3. Inventory Management",
      "item": [
        {
          "name": "Get Inventory Batches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/inventory"
          }
        },
        {
          "name": "Get Inventory Summary by Location",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/inventory/summary"
          }
        },
        {
          "name": "Inward / Add Stock (Admin & Ops)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/inventory/add",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"ITEM_ID_HERE\",\n  \"locationId\": \"LOCATION_ID_HERE\",\n  \"batch\": \"BATCH-2026-X\",\n  \"physicalQty\": 50\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "4. Work Orders (with Shortage Logic)",
      "item": [
        {
          "name": "Get Work Orders (Auto calculates shortage)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/work-orders"
          }
        },
        {
          "name": "Create Work Order (Admin Only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/work-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"WO-1002\",\n  \"locationId\": \"LOCATION_ID_HERE\",\n  \"itemId\": \"ITEM_ID_HERE\",\n  \"requiredQty\": 60,\n  \"assignedUserId\": \"USER_ID_HERE\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Advance Status to IN_PROGRESS",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/work-orders/WORK_ORDER_ID/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "5. Internal Stock Transfers",
      "item": [
        {
          "name": "Get Transfers List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers"
          }
        },
        {
          "name": "Request Internal Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferNumber\": \"TR-1002\",\n  \"sourceLocationId\": \"SOURCE_LOC_ID\",\n  \"destLocationId\": \"DEST_LOC_ID\",\n  \"itemId\": \"ITEM_ID\",\n  \"quantity\": 30\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Dispatch Transfer (Reduces Source Stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers/TRANSFER_ID/dispatch"
          }
        },
        {
          "name": "Receive Transfer (Increases Dest Stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers/TRANSFER_ID/receive"
          }
        }
      ]
    },
    {
      "name": "6. Customer Orders & Concurrency",
      "item": [
        {
          "name": "Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/customer-orders"
          }
        },
        {
          "name": "Create Order & Reserve (Locking Protected)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/customer-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"SO-1002\",\n  \"customerName\": \"Bharat Heavy Electricals Ltd\",\n  \"locationId\": \"LOCATION_ID\",\n  \"itemId\": \"ITEM_ID\",\n  \"quantity\": 25\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Cancel Order (Releases Reserved Stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/customer-orders/ORDER_ID/cancel"
          }
        }
      ]
    }
  ]
}
