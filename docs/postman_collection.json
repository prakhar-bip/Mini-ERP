{
  "info": {
    "name": "Mini Operations ERP API Collection",
    "description": "Postman Collection for Mini Operations ERP covering Auth, Master Data, Inventory, Work Orders, Transfers, and Customer Orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login - Operations",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ops@erp.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login - Sales",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@erp.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Current Session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Inventory Management",
      "item": [
        {
          "name": "Get All Inventories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/inventory"
          }
        },
        {
          "name": "Inward / Add Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/inventory/add",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"item-id-here\",\n  \"locationId\": \"location-id-here\",\n  \"batch\": \"BATCH-2026-X\",\n  \"physicalQty\": 50\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "3. Work Orders",
      "item": [
        {
          "name": "Get Work Orders (with auto shortage check)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/work-orders"
          }
        },
        {
          "name": "Create Work Order (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/work-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"WO-1002\",\n  \"locationId\": \"location-id\",\n  \"itemId\": \"item-id\",\n  \"requiredQty\": 40,\n  \"assignedUserId\": \"user-id\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "4. Internal Stock Transfers",
      "item": [
        {
          "name": "Get Transfers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers"
          }
        },
        {
          "name": "Request Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferNumber\": \"TR-1002\",\n  \"sourceLocationId\": \"source-id\",\n  \"destLocationId\": \"dest-id\",\n  \"itemId\": \"item-id\",\n  \"quantity\": 20\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Dispatch Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers/transfer-id-here/dispatch"
          }
        },
        {
          "name": "Receive Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transfers/transfer-id-here/receive"
          }
        }
      ]
    },
    {
      "name": "5. Customer Orders & Concurrency",
      "item": [
        {
          "name": "Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/customer-orders"
          }
        },
        {
          "name": "Create Order & Reserve Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/customer-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"SO-1002\",\n  \"customerName\": \"Bharat Heavy Electricals\",\n  \"locationId\": \"location-id\",\n  \"itemId\": \"item-id\",\n  \"quantity\": 30\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    }
  ]
}
